# Puerto de la aplicación (Dokploy usa 3000 por defecto)
PORT=3000

# Entorno de producción
NODE_ENV=production

# Base de datos PostgreSQL en Dokploy (Cadena de conexión interna del servicio PostgreSQL)
DATABASE_URL="postgresql://postgres:password_segura@nombre-servicio-db:5432/debatehosting?schema=public"

# Clave secreta para generación de tokens JWT de administración
JWT_SECRET="genera_aqui_una_clave_secreta_super_segura_jwt_2026"

# URL pública del sitio (para sitemap, robots y metadata SEO)
NEXT_PUBLIC_SITE_URL="https://tu-dominio.com"

# Opcional: Forzar repoblación de datos seed en el próximo despliegue (true/false)
# FORCE_SEED=false
